// Schéma de base de données — Fourchette & Fourche
// PostgreSQL (hébergé sur Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utilisateurs ----------

enum Role {
  RESTAURATEUR
  PRODUCTEUR
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  role          Role
  displayName   String
  phone         String?
  bio           String?
  avatarUrl     String?
  siret         String? // producteurs (et restaurateurs si souhaité)
  tvaIntracom   String? // numéro de TVA intracommunautaire (ex : FR12345678901)

  // Localisation
  address       String?
  city          String?
  postalCode    String?
  departement   String? // code : 01, 02, ..., 2A, 2B, ..., 974...
  region        String? // code ISO région
  lat           Float?
  lng           Float?

  isVerified    Boolean  @default(false)
  emailNotifications Boolean @default(true)

  // Stripe Connect (producteurs)
  stripeAccountId            String? @unique
  stripeOnboardingComplete   Boolean @default(false)

  certifications  String[] // BIO, LABEL_ROUGE, AOC, AOP, IGP, DEMETER...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings            Listing[]
  sentMessages        Message[]                 @relation("SentMessages")
  conversations       ConversationParticipant[]
  ordersAsBuyer       Order[]                   @relation("BuyerOrders")
  reviewsWritten      Review[]                  @relation("ReviewsWritten")
  reviewsReceived     Review[]                  @relation("ReviewsReceived")

  @@index([departement])
  @@index([region])
  @@index([role])
}

// ---------- Annonces ----------

enum Category {
  LEGUMES
  FRUITS
  VIANDE
  VOLAILLE
  POISSON
  FRUITS_DE_MER
  FROMAGE
  PRODUITS_LAITIERS
  OEUFS
  VIN
  BIERE
  BOISSONS
  MIEL
  EPICERIE
  FARINE
  HUILE
  HERBES_AROMATES
  FLEURS
  AUTRE
}

enum Unit {
  KG
  GRAMMES
  PIECE
  LITRE
  BOUTEILLE
  BOTTE
  SAC
  CAISSE
  DOUZAINE
}

model Listing {
  id          String   @id @default(uuid())
  producerId  String
  producer    User     @relation(fields: [producerId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    Category
  priceCents  Int // TOUJOURS en centimes (ex : 250 = 2,50 €)
  tvaCents    Int @default(550) // taux de TVA en centièmes de point : 0, 550 (5,5 %), 1000 (10 %), 2000 (20 %)
  unit        Unit
  poidsGrammes Int @default(1000) // poids d'UNE unité vendue, en grammes (frais de port)
  quantityAvailable Int
  quantitySold      Int @default(0)

  photos         String[] // URLs Supabase Storage
  certifications String[]

  // Localisation de l'annonce (par défaut = celle du producteur)
  address     String?
  city        String?
  departement String
  region      String
  lat         Float
  lng         Float

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  orderItems    OrderItem[]

  @@index([producerId])
  @@index([category])
  @@index([departement])
  @@index([region])
  @@index([isActive])
}

// ---------- Messagerie ----------

model Conversation {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------- Commandes ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  DISPUTED
}

enum DeliveryStatus {
  NOT_SHIPPED
  SHIPPED
  DELIVERED
}

model Order {
  id              String      @id @default(cuid())
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  totalCents      Int // produits + frais de port
  commissionCents Int // commission plateforme (10 % des produits uniquement)

  // Livraison (Mondial Relay)
  shippingMethod        String @default("DOMICILE") // "RELAIS" prévu plus tard
  shippingPriceCents    Int    @default(0) // frais de port payés par l'acheteur
  shippingAddressNom    String? // nom du destinataire (collecté par Stripe)
  shippingAddressLigne1 String?
  shippingAddressLigne2 String?
  shippingAddressCP     String?
  shippingAddressVille  String?
  shippingAddressPays   String? // défaut "FR"
  shippingAddressTel    String? // téléphone du destinataire (obligatoire Mondial Relay domicile)

  deliveryStatus       DeliveryStatus @default(NOT_SHIPPED)
  shippingCarrier      String?
  shippingTrackingNumber String?
  shippingTrackingUrl  String?
  shippedAt            DateTime?
  deliveredAt          DateTime?

  bordereauNumeroExpedition String? // n° d'expédition Mondial Relay
  bordereauPath        String? // PDF du bordereau dans le bucket privé "bordereaux"

  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
  invoices Invoice[]

  @@index([buyerId])
  @@index([deliveryStatus])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quantity       Float
  unitPriceCents Int
  subtotalCents  Int

  @@index([orderId])
}

// ---------- Facturation ----------

enum InvoiceType {
  ACHETEUR // FA — plateforme → restaurateur
  VENTE // FV — autofacturation au nom du producteur
  COMMISSION // FC — plateforme → producteur (10 %)
}

model Invoice {
  id              String      @id @default(cuid())
  numero          String      @unique // ex : FA-2026-00001
  type            InvoiceType
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  emitPourUserId  String? // le producteur pour FV/FC (null pour FA)
  sequence        Int
  annee           Int
  montantHtCents  Int
  tvaCents        Int
  montantTtcCents Int
  storagePath     String? // chemin dans le bucket privé "factures" (null si upload raté → rattrapage)
  createdAt       DateTime    @default(now())

  @@unique([type, sequence, annee])
  @@index([orderId])
  @@index([emitPourUserId])
}

// ---------- Avis ----------

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  producerId String
  producer   User     @relation("ReviewsReceived", fields: [producerId], references: [id], onDelete: Cascade)
  rating     Int // 1 à 5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([producerId])
}
