# ============================================
# Configuration — Fourchette & Fourche
# ============================================
# COPIE ce fichier en ".env.local" et remplis les valeurs.
# Ne partage JAMAIS le fichier .env.local (il est secret).
# Chaque valeur se récupère dans ton compte en ligne — voir GUIDE.md.

# --- Application ---
# L'adresse du site. En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (base de données + comptes utilisateurs + photos) ---
# Dans ton projet Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-a-coller-ici
SUPABASE_SERVICE_ROLE_KEY=cle-service-role-a-coller-ici

# --- Base de données (pooler session Supavisor) ---
# Dans Supabase : Project Settings > Database > Connect > Session pooler > URI
# (la connexion directe db.VOTRE-PROJET.supabase.co est IPv6 uniquement :
#  utiliser le pooler, ex. postgresql://postgres.VOTRE-PROJET:[YOUR-PASSWORD]
#  @aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require)
DATABASE_URL=postgresql://postgres.VOTRE-PROJET:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Stripe (paiements) ---
# Dans ton compte Stripe : Developers > API keys
# On commence avec les clés de TEST (elles commencent par sk_test / pk_test)
STRIPE_SECRET_KEY=sk_test_a-coller-ici
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_a-coller-ici
# Secret du webhook (Stripe : Developers > Webhooks) — utile seulement en Phase 5
STRIPE_WEBHOOK_SECRET=whsec_a-coller-plus-tard

# Commission de la plateforme en pourcentage (ex : 10 = 10 %)
PLATFORM_COMMISSION_PERCENT=10

# --- Société (informations légales pour les factures) ---
# Laisser vide tant que le statut auto-entrepreneur n'est pas obtenu :
# les factures afficheront « à compléter ».
SOCIETE_NOM=Fourchette & Fourche
SOCIETE_SIRET=
SOCIETE_TVA_INTRA=
SOCIETE_ADRESSE=
SOCIETE_VILLE=
SOCIETE_CODE_POSTAL=
# Taux de TVA appliqué à la commission de la plateforme (20 = 20 %)
PLATFORM_COMMISSION_TVA_PERCENT=20

# --- Mondial Relay (bordereaux d'envoi) ---
# Dans ton compte Mondial Relay Connect (portail business) :
#   identifiants de TEST d'abord (URL sandbox), puis de production.
# URL : https://connect-api-sandbox.mondialrelay.com/api/shipment (test)
#       https://connect-api.mondialrelay.com/api/shipment (production)
MONDIAL_RELAY_URL=https://connect-api-sandbox.mondialrelay.com/api/shipment
MONDIAL_RELAY_USER=identifiant-a-coller-ici
MONDIAL_RELAY_PASSWORD=mot-de-passe-a-coller-ici
MONDIAL_RELAY_CUSTOMER_ID=customer-id-a-coller-ici

# --- Resend (emails) ---
# Dans ton compte Resend : API Keys > Create API Key
# Tant que le domaine fourchette-fourche.fr n'est pas vérifié dans Resend,
# utilise l'expéditeur de test Resend (envoie uniquement vers ton propre email) :
#   RESEND_API_KEY=re_xxxxxxxxxxxxx
#   EMAIL_FROM="Fourchette & Fourche <onboarding@resend.dev>"
# Une fois le domaine vérifié, remplace par l'adresse définitive :
#   EMAIL_FROM="Fourchette & Fourche <noreply@fourchette-fourche.fr>"
RESEND_API_KEY=re_a-coller-plus-tard
EMAIL_FROM="Fourchette & Fourche <onboarding@resend.dev>"
