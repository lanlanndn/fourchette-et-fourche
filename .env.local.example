# ============================================
# Configuration — Fourchette & Fourche
# ============================================
# COPIE ce fichier en ".env.local" et remplis les valeurs.
# Ne partage JAMAIS le fichier .env.local (il est secret).
# Chaque valeur se récupère dans ton compte en ligne — voir GUIDE.md.

# --- Application ---
# L'adresse du site. En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (base de données + comptes utilisateurs + photos) ---
# Dans ton projet Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-a-coller-ici
SUPABASE_SERVICE_ROLE_KEY=cle-service-role-a-coller-ici

# --- Base de données (connexion directe pour Prisma) ---
# Dans Supabase : Project Settings > Database > Connection string > URI
# Remplace [YOUR-PASSWORD] par le mot de passe de la base choisi à la création du projet
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.VOTRE-PROJET.supabase.co:5432/postgres

# --- Stripe (paiements) ---
# Dans ton compte Stripe : Developers > API keys
# On commence avec les clés de TEST (elles commencent par sk_test / pk_test)
STRIPE_SECRET_KEY=sk_test_a-coller-ici
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_a-coller-ici
# Secret du webhook (Stripe : Developers > Webhooks) — utile seulement en Phase 5
STRIPE_WEBHOOK_SECRET=whsec_a-coller-plus-tard

# Commission de la plateforme en pourcentage (ex : 10 = 10 %)
PLATFORM_COMMISSION_PERCENT=10

# --- Resend (emails) ---
# Dans ton compte Resend : API Keys > Create API Key
# Tant que le domaine fourchette-fourche.fr n'est pas vérifié dans Resend,
# utilise l'expéditeur de test Resend (envoie uniquement vers ton propre email) :
#   RESEND_API_KEY=re_xxxxxxxxxxxxx
#   EMAIL_FROM="Fourchette & Fourche <onboarding@resend.dev>"
# Une fois le domaine vérifié, remplace par l'adresse définitive :
#   EMAIL_FROM="Fourchette & Fourche <noreply@fourchette-fourche.fr>"
RESEND_API_KEY=re_a-coller-plus-tard
EMAIL_FROM="Fourchette & Fourche <onboarding@resend.dev>"
